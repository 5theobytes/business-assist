# Copy this file to .env and add only credentials for integrations you enable.
# Never commit .env or paste real secrets into issues, logs, or evaluation data.

# LLM backend: anthropic, vertex (Claude on Vertex), or gemini (Gemini on Vertex).
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
VERTEX_MODEL=
VERTEX_REGION=
VERTEX_PROJECT_ID=
GEMINI_MODEL=
GEMINI_LOCATION=

# Workflow selected by the application. Available versions are v1, v2, v3, v4.
WORKFLOW=v2

# Use memory for local development. Choose a dedicated Firestore database for
# durable storage; do not use a production database for tests or experiments.
SESSION_STORE=memory
FIRESTORE_DATABASE=
FIRESTORE_COLLECTION=sessions
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_PRIVATE_KEY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional integrations. Leave unset when not used.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TOKEN=
PUBLIC_URL=
GOOGLE_SHEETS_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PAYMENT_CTA_URL=
SYNC_DEBOUNCE_SECONDS=30
